<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
        size="190 244">
    <image source="minecolonies:textures/gui/builderhut/builder_paper.png" size="190 244"/>
    <text size="160 11" pos="15 12" textalign="MIDDLE" color="black"
          label="$(com.caravan.gui.overview)"/>
    <!-- 需求：返回按钮上移至与【交易列表】的【总览】按钮一致的位置（y=214），
         激活交易表相应缩短（27 → 178 高）。 -->
    <list id="overview" size="166 178" pos="12 27">
        <!-- 需求：两行布局——第一行 售出物 → 购入物（图标带角标），
             第二行 状态（单次/按需/重复）+ 位置信息；右侧上下箭头纵向排列，
             左右位置为原下箭头位置（148）左移 4 像素（144）。 -->
        <view size="100% 34">
            <box size="100% 34" linewidth="1">
                <itemicon id="costIcon" size="14 14" pos="3 3"/>
                <text id="arrowIcon" size="10 10" pos="19 5" textalign="MIDDLE" color="black" label="→"/>
                <itemicon id="resultIcon" size="14 14" pos="31 3"/>
                <text id="offerInfo" size="92 10" pos="48 20" textalign="MIDDLE_LEFT" color="black"/>
                <button id="moveUp" size="16 10" pos="144 2" color="black"
                        source="minecolonies:textures/gui/builderhut/builder_button_mini.png" label="↑"/>
                <button id="moveDown" size="16 10" pos="144 20" color="black"
                        source="minecolonies:textures/gui/builderhut/builder_button_mini.png" label="↓"/>
            </box>
        </view>
    </list>
    <!-- 需求（总览）：右下角【返回】按钮——与【交易列表】的【总览】按钮位置一致。 -->
    <button id="backButton" size="62 12" pos="116 214" color="black"
            source="minecolonies:textures/gui/builderhut/builder_button_mini.png"
            label="$(com.caravan.gui.trades.back)"/>
</window>
