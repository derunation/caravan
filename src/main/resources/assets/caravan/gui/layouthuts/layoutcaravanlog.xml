<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
        size="190 244">
    <image source="minecolonies:textures/gui/builderhut/builder_paper.png" size="190 244"/>
    <text size="160 11" pos="15 12" textalign="MIDDLE" color="black"
          label="$(com.caravan.gui.log)"/>
    <text id="logInfo" size="160 11" pos="15 25" textalign="MIDDLE" color="black"/>
    <text id="statusText" size="160 11" pos="15 38" textalign="MIDDLE" color="black"/>
    <text size="160 11" pos="15 52" textalign="MIDDLE" color="black"
          label="$(com.caravan.gui.log.trades)"/>
    <list id="trades" size="166 121" pos="12 64">
        <!-- 需求：每条交易之间额外空出 4 像素（行高 23 + 4）。 -->
        <view size="100% 27">
            <box size="100% 23" linewidth="0">
                <text id="tradeLine" size="160 10" pos="3 1" textalign="MIDDLE_LEFT" color="black"/>
                <text size="36 9" pos="3 12" textalign="MIDDLE_LEFT" color="black"
                      label="$(com.caravan.gui.trades.cost)"/>
                <itemicon id="costAIcon" size="16 16" pos="40 11"/>
                <itemicon id="costBIcon" size="16 16" pos="58 11"/>
                <text size="36 9" pos="80 12" textalign="MIDDLE_LEFT" color="black"
                      label="$(com.caravan.gui.trades.result)"/>
                <itemicon id="resultIcon" size="16 16" pos="118 11"/>
            </box>
        </view>
    </list>
    <!-- 需求（GUI）：消耗品单行——帐篷-食物-饱食度-火把按顺序排布：
         帐篷每顶独立图标（含耐久度条），食物/火把每个堆叠一个图标（带数量角标），
         饱食度图标在食物右侧（无人饥饿=满图标，有人饥饿=空图标）。 -->
    <text id="consumablesTitle" size="160 11" pos="15 185" textalign="MIDDLE" color="black"
          label="$(com.caravan.gui.log.consumables)"/>
    <itemicon id="tentIcon0" size="16 16" pos="14 196"/>
    <itemicon id="tentIcon1" size="16 16" pos="30 196"/>
    <itemicon id="tentIcon2" size="16 16" pos="46 196"/>
    <itemicon id="foodIcon0" size="16 16" pos="62 196"/>
    <itemicon id="foodIcon1" size="16 16" pos="78 196"/>
    <itemicon id="foodIcon2" size="16 16" pos="94 196"/>
    <itemicon id="saturationIcon" size="16 16" pos="110 196"/>
    <itemicon id="torchIcon0" size="16 16" pos="126 196"/>
    <itemicon id="torchIcon1" size="16 16" pos="142 196"/>
    <itemicon id="torchIcon2" size="16 16" pos="158 196"/>
    <text id="tentInfo" size="150 22" pos="20 196" textalign="MIDDLE_LEFT" color="black" wrap="true"/>
</window>
